{
  "name": "vhc-pharmacy-pos",
  "private": true,
  "version": "3.18.3",
  "description": "NARPAVI HEALTH CARE POS Pharmacy Software",
  "author": "NHC Pharmacy",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dist": "electron-builder --win",
    "test:database": "set ELECTRON_RUN_AS_NODE=1&& electron electron/database.selftest.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.112.3",
    "better-sqlite3": "12.11.1",
    "date-fns": "^4.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.narpavi.nhcpharmacy",
    "productName": "NHC Pharmacy POS",
    "electronVersion": "34.0.0",
    "directories": {
      "output": "C:/New VHC/release-Pharmacy"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "telegram-bot/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "telegram-bot/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NHC Pharmacy POS",
      "include": "build/installer.nsh",
      "artifactName": "NHC_Pharmacy_POS_Setup_${version}.exe"
    }
  }
}
