# Safe VHC cloud validation only. Never put production credentials here.
VHC_SUPABASE_ENVIRONMENT=TEST
VHC_TEST_SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
VHC_TEST_SUPABASE_ANON_KEY=YOUR-TEST-ANON-KEY

